  "quests": [
    {
      "id": 4,
      "title": "Ein Lichtstreif... [TEST M6]",
      "group": 3,
      "journal": {
        "take": "Tago hat von einem Fremden erzählt, der in Komorin auf dich wartet. Du findest ihn im südlichen Teil der Stadt. Es muss derselbe Mann sein, der vor zwei Wochen um ein Treffen in Thalmont angefragt hat.",
        "solve": "",
        "close": "Du hast Gandohar im südlichen Teil von Komorin getroffen."
      },
      "giver": 3,
      "giver_type": "ACTIVE",
      "map_sign": "AUTO_CLOSE_ON_SOLVE",
      "offered": true,
      "enable_level": 1,
      "speakers": [
        {
          "id": 3,
          "name": "Tago",
          "lector": 123,
          "tile": "E1",
          "new": false
        }
      ],
      "graph": {
        "nodes": {
          "entry:first": {
            "type": "entry",
